---
import '../styles/global.css';
import { C } from '../data/content.js';
const { title, desc = 'Tiny labels that bring lost phones home.' } = Astro.props;
const cur = Astro.url.pathname.replace(/\/$/, '');
const href = (k) => (k === 'home' ? '/' : `/${k}/`);
const full = title === C.brand ? C.brand : `${title} | ${C.brand}`;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{full}</title><meta name="description" content={desc} /><link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,900&family=Figtree:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div id="intro" aria-hidden="true"><div class="ilab"><span>Fast</span><span>Find</span><span>Label</span></div></div>
<header class="bar"><a class="logo" href="/" aria-label="Fast Find Label, home"><i></i>{C.brand}</a>
<nav id="nav" aria-label="Main">{C.nav.map(([k, l]) => <a data-k={k} href={href(k)} aria-current={cur === href(k).replace(/\/$/, '') ? 'page' : undefined}>{l}</a>)}</nav></header>
<main id="main" tabindex="-1"><slot /></main>
<footer id="foot"><span>{C.foot}</span></footer>
{cur !== '/order' && <a class="btn buybar" href="/#shop">Get my labels from ${Math.min(...C.price.map((p) => p.p))}</a>}
<script>import '../scripts/client.js';</script>
</body>
</html>
