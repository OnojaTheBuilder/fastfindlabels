---
import Base from '../layouts/Base.astro';
import Label from '../components/Label.astro';
import { C } from '../data/content.js';
const o = C.order;
const telPat = String.raw`\(\d{3}\) \d{3}-\d{4}`, zipPat = String.raw`\d{5}`;
---
<Base title="Order" desc="Order Fast Find Label: tiny thermal-printed labels that help bring a lost phone home. US orders only.">
<section class="pagehead"><h1 class="head" data-split>{o.title}</h1><p class="sub" data-r>{o.sub}</p></section>
<section class="order">
<form id="of">
<fieldset><legend>{o.packs}</legend>{C.price.map((p, i) => <label class="pk"><input type="radio" name="pack" value={i} checked={i === 0} /> <span><b>${p.p}</b> {p.n}</span></label>)}</fieldset>
<label class="f">{o.tel}<input id="tn" name="tel" type="tel" inputmode="tel" required pattern={telPat} placeholder="(555) 555-5555" autocomplete="off" /><small class="h" set:html={o.telHint}></small></label>
<label class="f">{o.name}<input name="name" type="text" required autocomplete="name" /></label>
<label class="f">{o.email}<input name="email" type="email" required autocomplete="email" /></label>
<label class="f">{o.street}<input name="street" type="text" required autocomplete="street-address" /></label>
<label class="f">{o.apt}<input name="apt" type="text" autocomplete="address-line2" /></label>
<div class="g3"><label class="f">{o.city}<input name="city" type="text" required /></label><label class="f">{o.state}<input name="state" type="text" required maxlength="2" autocomplete="address-level1" /></label><label class="f">{o.zip}<input name="zip" type="text" required inputmode="numeric" pattern={zipPat} maxlength="5" autocomplete="postal-code" /></label></div>
<p><b>{o.total}: <span id="tot"></span></b></p>
<button class="btn mag" type="submit">{o.pay}</button>
<div id="pp"></div>
<small class="h">{o.demoNote} {C.priceNote}</small>
<ul class="tr">{C.trust.map((t) => <li>{t}</li>)}</ul>
</form>
<aside class="prev"><h2>{o.prev}</h2><Label /></aside>
<div id="done" style="grid-column:1/-1" role="status"></div>
</section>
</Base>
